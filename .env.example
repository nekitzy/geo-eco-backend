# ====================================
# БАЗА ДАННЫХ
# ====================================
DB_NAME=noiselevel
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_HOST=localhost
DB_PORT=5432

# ====================================
# JWT — сгенерируй командой:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
# ====================================
JWT_SECRET_KEY=your_secret_key_here

# ====================================
# СЕРВЕР
# ====================================
HOST=0.0.0.0
PORT=8000

# ====================================
# БАЙКАЛ-8 SEEDLINK
# ====================================
SEEDLINK_ADDRESS=192.168.1.10:18000
SEEDLINK_SELECT=NT_B8:CH3

# ====================================
# ДИРЕКТОРИИ
# ====================================
DATA_DIR=./data

# ====================================
# ПОЛЬЗОВАТЕЛИ (первый запуск)
# ====================================
ADMIN_LOGIN=admin
ADMIN_PASSWORD=your_admin_password
VIEWER_LOGIN=viewer
VIEWER_PASSWORD=your_viewer_password